{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "cwd": "server",
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "cupreview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--config", "vite.cupreview.config.js", "--host", "127.0.0.1", "--port", "5220"],
      "port": 5220
    }
  ]
}
