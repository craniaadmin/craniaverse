# SendGrid configuration for registration emails.
# Get your API key from https://app.sendgrid.com/settings/api_keys
# Copy this file to server/.env and fill in the real key.
SENDGRID_API_KEY=SG.your-key-here

# Optional: override the URL used for the "Information for Registered
# Students" link in the guardian confirmation email. Defaults to
# https://www.crania-schools.com/registered-students
# REGISTERED_STUDENTS_URL=https://www.crania-schools.com/registered-students

# Optional: port override (defaults to 4000)
# PORT=4000

# ---- PocketBase ---------------------------------------------
# The Express API talks to PocketBase for all storage. PocketBase
# itself runs as a separate process (see ecosystem.config.cjs).
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=admin@craniaverse.local
PB_ADMIN_PASSWORD=change-me-please

# ---- Admin login for the CraniaVerse React app ---------------
# ADMIN_PASSWORD  — the shared password that unlocks the admin UI.
# SESSION_SECRET  — random 32+ character string used to sign session
#                   cookies. Generate one with:
#                     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Both are REQUIRED for the admin API to accept requests.
ADMIN_PASSWORD=change-me-in-server-env
SESSION_SECRET=replace-with-a-long-random-string

# ---- Public sign-up host (conceals the admin) ----------------
# Comma-separated hostnames that should ONLY serve the booth
# sign-up form and its POST endpoint. Every other URL on these
# hosts returns 404, so the admin app is invisible to anyone who
# scans the QR / hits the sign-up domain. Leave blank if unused.
# Example:
#   SIGNUP_HOSTS=crania-signup.ngrok.app,sign-up.crania-schools.com
SIGNUP_HOSTS=

# ---- Continuous smoke tests --------------------------------
# Where to email when tests fail. Reuses SENDGRID_API_KEY above.
# Leave blank to skip email (failures still hit tests/logs/).
TEST_NOTIFY_EMAIL=
# Sender shown on test emails — must be a SendGrid-verified
# sender. Defaults to the registrations sender if unset.
# TEST_NOTIFY_FROM=registrations@crania-schools.com
# Base URL the tests hit. Defaults to http://localhost:4000.
# TEST_BASE_URL=http://localhost:4000
